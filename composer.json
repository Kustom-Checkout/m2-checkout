{
    "name": "kustom/module-checkout",
    "type": "metapackage",
    "version": "3.0.0",
    "license": "Apache-2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": {
            "kustom/*": "source",
            "*": "dist"
        }
    },
    "require": {
        "kustom/module-admin-settings":  "dev-fix/KUSTOM-118-remove-old-code as 1.3.0",
        "kustom/module-backend":  "12.0.0",
        "kustom/module-base":  "dev-fix/KUSTOM-118-remove-old-code as 12.0.0",
        "kustom/module-kco": "12.2.0",
        "kustom/module-kss":  "3.2.0",
        "kustom/module-logger": "3.1.0",
        "kustom/module-orderlines":  "3.1.1",
        "kustom/module-osm":  "4.1.1",
        "kustom/module-plugins-api":  "dev-fix/KUSTOM-118-remove-old-code as 1.1.0",
        "kustom/module-support":  "dev-fix/KUSTOM-118-remove-old-code as 3.1.1"
    }
}

